# Zugangsdaten fuer den Playwright-Lauf (npm run test:e2e).
#
# WICHTIG: eine eigene, leere Postgres-Datenbank – niemals die Produktivdatenbank.
# Der Seed in e2e/seed.ts leert Tabellen. Er verweigert den Dienst ohne E2E_ALLOW_RESET=1
# und bricht ab, sobald er fremde Verkaeufer vorfindet.
#
# Diese Datei nach .env.test kopieren und ausfuellen.

E2E_ALLOW_RESET=1

POSTGRES_PRISMA_URL=postgres://USER:PASS@TEST-HOST:5432/postgres
POSTGRES_URL_NON_POOLING=postgres://USER:PASS@TEST-HOST:5432/postgres

JWT_SECRET=e2e-nur-lokal-egal-was-hier-steht
ADMIN_USER=admin
ADMIN_PASS=e2e-admin-pass

NEXT_PUBLIC_BASE_URL=http://localhost:3001

# UPSTASH_* absichtlich NICHT setzen: ohne Redis greift der In-Memory-Fallback in
# app/lib/rateLimit.ts, der Lauf verbraucht dann kein gemeinsames Login-Kontingent.
