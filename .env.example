# -------------------------------------------------------
# .env.example – Kopiere diese Datei als ".env" und fülle
# alle Felder aus, bevor du "npx prisma db push" ausführst.
# -------------------------------------------------------

# Admin-Zugangsdaten
ADMIN_USER=admin
ADMIN_PASS=deinSicheresPasswort

# PostgreSQL-Datenbank (Pflichtfeld!)
# Kostenlos z. B. bei https://neon.tech oder https://supabase.com
# Pooling-URL (für Prisma Client / Laufzeit):
POSTGRES_PRISMA_URL=postgres://USER:PASS@HOST:5432/DBNAME?sslmode=require
# Direkte URL (für Migrationen / prisma db push):
POSTGRES_URL_NON_POOLING=postgres://USER:PASS@HOST:5432/DBNAME?sslmode=require

# E-Mail-Versand (Mailjet)
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=deineMailjetAPIKey
SMTP_PASS=deinMailjetSecretKey
MAIL_FROM=Kinderbasar Neukirchen <deine@email.de>

# Sicherheitsschlüssel (beliebiger langer Zufallsstring)
JWT_SECRET=deinGeheimesPasswort123

# Öffentliche Basis-URL der App (für E-Mail-Links)
NEXT_PUBLIC_BASE_URL=https://kinderbasar-neukirchen.vercel.app

# Redis-basiertes Rate Limiting (optional)
# Kostenlos z. B. bei https://upstash.com – ohne diese beiden Variablen fällt
# app/lib/rateLimit.ts auf einen In-Memory-Fallback zurück, der NUR für lokale Entwicklung
# geeignet ist (nicht über mehrere Serverless-Instanzen hinweg geteilt, siehe Kommentar dort).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
