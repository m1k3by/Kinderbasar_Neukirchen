generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Seller {
  sellerId           Int      @id
  email              String   @unique
  firstName          String
  lastName           String
  isEmployee         Boolean  @default(false)
  isCashier          Boolean  @default(false)
  sellerStatusActive Boolean  @default(false)
  createdAt          DateTime @default(now())
  password           String?
  qrCode             String?
  barcode            String?
  resetToken         String?  @unique
  resetTokenExpiry   DateTime?
  taskSignups        TaskSignup[]
  cakes              Cake[]
  basarSellers       BasarSeller[]
  cashierSales       Sale[]         @relation("CashierSales")
  sellerArticles     SellerArticle[]
}

model Task {
  id        String   @id @default(cuid())
  title     String
  day       String
  timeFrom  String?
  timeTo    String?
  capacity  Int
  createdAt DateTime @default(now())
  signups   TaskSignup[]
}

model TaskSignup {
  id        String   @id @default(cuid())
  taskId    String
  sellerId  Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  seller    Seller   @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([taskId, sellerId])
}

model Cake {
  id        String   @id @default(cuid())
  cakeName  String
  sellerId  Int
  seller    Seller   @relation(fields: [sellerId], references: [sellerId])
  createdAt DateTime @default(now())
}

model Settings {
  id            String   @id @default(cuid())
  key           String   @unique
  value         String
  updatedAt     DateTime @updatedAt
}

// ───────────────────────────────────────────────
// Basar Feature
// ───────────────────────────────────────────────

enum BasarStatus {
  DRAFT
  OPEN
  ACTIVE
  CLOSED
}

enum ArticleStatus {
  AVAILABLE
  SOLD
  RETURNED
}

model Basar {
  id                   String      @id @default(cuid())
  title                String
  description          String?
  eventDate            DateTime
  location             String?
  maxSellers           Int         @default(100)
  maxArticlesPerSeller Int         @default(50)
  commissionPercent    Decimal     @db.Decimal(5, 2) @default(20)
  entryFee             Decimal     @db.Decimal(6, 2) @default(0)
  status               BasarStatus @default(DRAFT)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  basarSellers         BasarSeller[]
  sales                Sale[]
}

model BasarSeller {
  id                  String    @id @default(cuid())
  basarId             String
  sellerId            Int
  maxArticlesOverride Int?
  commissionOverride  Decimal?  @db.Decimal(5, 2)
  createdAt           DateTime  @default(now())
  basar               Basar     @relation(fields: [basarId], references: [id], onDelete: Cascade)
  seller              Seller    @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)
  articles            Article[]
  settlement          Settlement?

  @@unique([basarId, sellerId])
}

model Article {
  id              String        @id @default(cuid())
  basarSellerId   String
  sellerArticleId String?
  title           String        @db.VarChar(120)
  sizeLabel       String?       @db.VarChar(40)
  gender          String?       @db.VarChar(10)
  price           Decimal       @db.Decimal(6, 2)
  qrCode          String
  status          ArticleStatus @default(AVAILABLE)
  soldAt          DateTime?
  createdAt       DateTime      @default(now())
  basarSeller     BasarSeller    @relation(fields: [basarSellerId], references: [id], onDelete: Cascade)
  sellerArticle   SellerArticle? @relation(fields: [sellerArticleId], references: [id])
  sales           Sale[]

  @@index([basarSellerId, status])
  @@index([qrCode])
}

// Personal article archive – survives basar closures
model SellerArticle {
  id        String    @id @default(cuid())
  sellerId  Int
  title     String    @db.VarChar(120)
  sizeLabel String?   @db.VarChar(40)
  gender    String?   @db.VarChar(10)
  price     Decimal   @db.Decimal(6, 2)
  qrCode    String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  seller    Seller    @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)
  articles  Article[]
}

model Sale {
  id          String   @id @default(cuid())
  basarId     String
  articleId   String
  cashierId   Int?
  salePrice   Decimal  @db.Decimal(6, 2)
  soldAt      DateTime @default(now())
  syncedAt    DateTime?
  isCancelled Boolean  @default(false)
  basar       Basar    @relation(fields: [basarId], references: [id])
  article     Article  @relation(fields: [articleId], references: [id])
  cashier     Seller?  @relation("CashierSales", fields: [cashierId], references: [sellerId])

  @@index([basarId, soldAt])
  @@index([articleId])
}

model Settlement {
  id               String      @id @default(cuid())
  basarId          String
  basarSellerId    String      @unique
  grossRevenue     Decimal     @db.Decimal(10, 2)
  commissionAmount Decimal     @db.Decimal(10, 2)
  entryFeeAmount   Decimal     @db.Decimal(10, 2)
  netPayout        Decimal     @db.Decimal(10, 2)
  generatedAt      DateTime    @default(now())
  basarSeller      BasarSeller @relation(fields: [basarSellerId], references: [id])
}
