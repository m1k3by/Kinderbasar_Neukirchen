generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Seller {
  sellerId           Int      @id
  email              String   @unique
  firstName          String
  lastName           String
  isEmployee         Boolean  @default(false)
  isCashier          Boolean  @default(false)
  createdAt          DateTime @default(now())
  password           String?
  qrCode             String?
  barcode            String?
  resetToken         String?  @unique
  resetTokenExpiry   DateTime?
  taskSignups        TaskSignup[]
  cakes              Cake[]
  basarSellers       BasarSeller[]
  cashierSales       Sale[]         @relation("CashierSales")
  cancelledSales     Sale[]         @relation("CancelledSales")
  sellerArticles     SellerArticle[]
}

model Task {
  id        String   @id @default(cuid())
  title     String
  day       String
  timeFrom  String?
  timeTo    String?
  capacity  Int
  createdAt DateTime @default(now())
  signups   TaskSignup[]
}

model TaskSignup {
  id        String   @id @default(cuid())
  taskId    String
  sellerId  Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  seller    Seller   @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([taskId, sellerId])
}

model Cake {
  id        String   @id @default(cuid())
  cakeName  String
  sellerId  Int
  seller    Seller   @relation(fields: [sellerId], references: [sellerId])
  createdAt DateTime @default(now())
}

// ───────────────────────────────────────────────
// Basar Feature
// ───────────────────────────────────────────────

enum BasarStatus {
  DRAFT
  OPEN
  ACTIVE
  CLOSED
}

enum ArticleStatus {
  AVAILABLE
  SOLD
  RETURNED
}

model Basar {
  id                   String      @id @default(cuid())
  title                String
  description          String?
  // Abgeleitet aus dateFriday/dateSaturday/dateSunday (frühester gesetzter Tag),
  // siehe deriveEventDate in app/lib/basarWindows.ts. Bleibt als Sortierschlüssel
  // und für Listen-/Archivanzeigen erhalten, wird nicht eigenständig gepflegt.
  eventDate            DateTime
  location             String?
  maxSellers           Int         @default(100)
  maxArticlesPerSeller Int         @default(50)
  // Eigenes Artikellimit für Mitarbeiter/Orga (Seller.isEmployee). null = kein eigenes
  // Limit, es gilt maxArticlesPerSeller. Bewusst nullable statt Pflichtfeld mit Vorgabewert:
  // sonst würde ein Bestandsbasar mit 80 Artikeln pro Verkäufer das Mitarbeiterlimit
  // stillschweigend auf den Vorgabewert senken. Siehe app/lib/articleLimits.ts.
  maxArticlesPerEmployee Int?
  commissionPercent    Decimal     @db.Decimal(5, 2) @default(20)
  entryFee             Decimal     @db.Decimal(6, 2) @default(0)
  status               BasarStatus @default(DRAFT)
  isArchived           Boolean     @default(false)

  // Basartage. Task.day ("Freitag") wird über dateForWeekday hierauf abgebildet.
  dateFriday                DateTime?
  dateSaturday              DateTime?
  dateSunday                DateTime?

  // Zeitfenster für die Teilnahme-Aktivierung (app/api/basars/[id]/participation).
  // Die Kontoregistrierung selbst ist basar-unabhängig und kennt kein Zeitfenster.
  // Nicht gesetzt = keine Einschränkung (siehe isWindowOpen).
  activationSellerStart     DateTime?
  activationSellerEnd       DateTime?
  activationEmployeeStart   DateTime?
  activationEmployeeEnd     DateTime?

  // Logistik – fließt in die Teilnahme-Bestätigungsmail ein (bei Aktivierung, nicht bei Registrierung).
  deliveryStart             DateTime?
  deliveryEnd               DateTime?
  deliveryStart2            DateTime?
  deliveryEnd2              DateTime?
  pickupStart               DateTime?
  pickupEnd                 DateTime?
  pickupStart2              DateTime?
  pickupEnd2                DateTime?

  // CSV, beim Anlegen aus DEFAULT_SIZES (app/lib/sizes.ts) vorbelegt.
  allowedSizes              String?   @db.Text

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  basarSellers         BasarSeller[]
  sales                Sale[]
}

model BasarSeller {
  id                  String    @id @default(cuid())
  basarId             String
  sellerId            Int
  maxArticlesOverride Int?
  commissionOverride  Decimal?  @db.Decimal(5, 2)
  // Teilnahme an genau diesem Basar. Ersetzt das globale Seller.sellerStatusActive.
  // Eine Abmeldung setzt isActive=false statt die Zeile zu löschen – an ihr hängen
  // Artikel mit onDelete: Cascade.
  isActive            Boolean   @default(true)
  activatedAt         DateTime?
  // Zeitpunkt, zu dem der Verkäufer AGB und Datenschutzerklärung für diesen Basar
  // bestätigt hat (Dialog beim Aktivieren der Teilnahme). Bleibt null, wenn ein Admin
  // die Teilnahme stellvertretend aktiviert – dann liegt keine eigene Zustimmung vor.
  termsAcceptedAt     DateTime?
  // Fassungen, denen dabei zugestimmt wurde (siehe app/lib/legalDocs.ts). Ohne sie belegt
  // termsAcceptedAt nur "hat irgendwann geklickt", nicht wozu – nach der ersten Textänderung
  // wäre der Nachweis wertlos. Werden serverseitig gesetzt, nie aus dem Request übernommen.
  termsVersion        String?   @db.VarChar(32)
  privacyVersion      String?   @db.VarChar(32)
  createdAt           DateTime  @default(now())
  basar               Basar     @relation(fields: [basarId], references: [id], onDelete: Cascade)
  seller              Seller    @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)
  articles            Article[]
  settlement          Settlement?

  @@unique([basarId, sellerId])
  // GET /api/basars zählt je Basar die aktiven Teilnahmen (_count mit where isActive) –
  // das läuft bei jedem Verkäufer-Dashboard-Aufruf über bis zu 50 Basare. Der Unique-Index
  // [basarId, sellerId] deckt nur basarId ab, isActive müsste je Zeile aus dem Heap geholt
  // werden: bei 5000 Teilnehmern × 19 Basaren sind das ~95.000 Zeilen pro Seitenaufruf.
  @@index([basarId, isActive])
}

model Article {
  id              String        @id @default(cuid())
  basarSellerId   String
  sellerArticleId String?
  title           String        @db.VarChar(120)
  sizeLabel       String?       @db.VarChar(40)
  gender          String?       @db.VarChar(10)
  price           Decimal       @db.Decimal(6, 2)
  qrCode          String
  status          ArticleStatus @default(AVAILABLE)
  soldAt          DateTime?
  createdAt       DateTime      @default(now())
  basarSeller     BasarSeller    @relation(fields: [basarSellerId], references: [id], onDelete: Cascade)
  sellerArticle   SellerArticle? @relation(fields: [sellerArticleId], references: [id])
  sales           Sale[]

  @@index([basarSellerId, status])
  @@index([qrCode])
  // FK-Index für updateMany({ where: { sellerArticleId } }) beim Archiv-Löschen –
  // Prisma legt für Fremdschlüssel keine Indizes an, ohne ihn ist das ein Seq Scan.
  @@index([sellerArticleId])
}

// Personal article archive – survives basar closures
model SellerArticle {
  id        String    @id @default(cuid())
  sellerId  Int
  title     String    @db.VarChar(120)
  sizeLabel String?   @db.VarChar(40)
  gender    String?   @db.VarChar(10)
  price     Decimal   @db.Decimal(6, 2)
  qrCode    String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  seller    Seller    @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)
  articles  Article[]

  // Jeder Archiv-Aufruf (GET /api/seller-articles) filtert auf sellerId – ohne Index
  // wächst das mit der Gesamttabelle statt mit dem eigenen Archiv.
  @@index([sellerId])
}

model Sale {
  id          String   @id @default(cuid())
  basarId     String
  articleId   String
  cashierId   Int?
  salePrice   Decimal  @db.Decimal(6, 2)
  soldAt      DateTime @default(now())
  syncedAt    DateTime?
  isCancelled Boolean  @default(false)
  // Idempotenz-/Gruppierungsschlüssel eines Kassiervorgangs (siehe app/admin/basars/[id]/kasse/page.tsx).
  // Nullable, additiv – Altbestand bleibt null und wird als Einzelvorgang behandelt.
  clientTxId  String?
  // Storno-Protokoll. cancelledAt ist der Marker: ist es gesetzt und cancelledById null,
  // hat ein Admin storniert (Admins haben keine sellerId). Beides null bei Altbestand –
  // dort ist nur isCancelled bekannt, nicht wer und wann.
  cancelledAt   DateTime?
  cancelledById Int?
  basar       Basar    @relation(fields: [basarId], references: [id])
  article     Article  @relation(fields: [articleId], references: [id])
  cashier     Seller?  @relation("CashierSales", fields: [cashierId], references: [sellerId])
  cancelledBy Seller?  @relation("CancelledSales", fields: [cancelledById], references: [sellerId])

  @@index([basarId, soldAt])
  @@index([articleId])
  @@index([basarId, clientTxId])
  @@index([basarId, cancelledAt])
}

model Settlement {
  id               String      @id @default(cuid())
  basarId          String
  basarSellerId    String      @unique
  grossRevenue     Decimal     @db.Decimal(10, 2)
  commissionAmount Decimal     @db.Decimal(10, 2)
  entryFeeAmount   Decimal     @db.Decimal(10, 2)
  netPayout        Decimal     @db.Decimal(10, 2)
  generatedAt      DateTime    @default(now())
  basarSeller      BasarSeller @relation(fields: [basarSellerId], references: [id])

  // Abrechnungsliste und Neu-Erzeugung filtern auf basarId (GET/POST /settlements).
  @@index([basarId])
}

// ───────────────────────────────────────────────
// Scalability infrastructure (registration thundering herd)
// ───────────────────────────────────────────────

// Single-row atomic counter for sellerId allocation (1000-9999). Replaces the old
// "load all sellerIds and scan for a gap" approach, which was O(n) per registration and
// raced under parallel signups. Allocation is a single atomic UPDATE...RETURNING – see
// app/api/register/route.ts. Gaps from deleted sellers are no longer reclaimed (monotonic
// counter), which trades gap-filling for correctness under 2000+ concurrent registrations.
model SellerIdCounter {
  id     String @id @default("default")
  nextId Int    @default(1000)
}

enum MailStatus {
  PENDING
  SENT
  FAILED
}

// Outbound mail is enqueued here instead of being sent synchronously in the request path
// (registration in particular). A separate processor (app/api/admin/mail-queue/route.ts)
// drains PENDING rows in batches with retry/backoff, so a slow/unavailable SMTP server no
// longer blocks or times out user-facing requests, and failures are visible instead of
// silently swallowed.
model MailQueue {
  id              String     @id @default(cuid())
  to              String
  subject         String
  html            String
  attachmentsJson String?
  status          MailStatus @default(PENDING)
  attempts        Int        @default(0)
  lastError       String?
  createdAt       DateTime   @default(now())
  sentAt          DateTime?

  @@index([status, createdAt])
}

// ───────────────────────────────────────────────
// Help assistant (Stufe 1) – search feedback logging
// ───────────────────────────────────────────────

// One row per question asked to the in-app help assistant. Written by
// app/api/chat-feedback/route.ts and read by app/admin/hilfe (unanswered /
// unhelpful queries surface gaps in the FAQ content).
model ChatLog {
  id           String   @id @default(cuid())
  sellerId     Int?
  role         String
  question     String   @db.VarChar(300)
  matchedFaqId String?
  resultType   String
  helpful      Boolean?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
